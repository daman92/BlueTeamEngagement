#!/usr/bin/env bash
# vendor-deps — bundle driftwatch's dependencies for OFFLINE, air-gapped deployment.
#
# The portable kit runs on client networks with no internet. Dependencies must therefore
# travel WITH the kit. This script has two jobs:
#
#   1. `python`   (re)build vendor/python/ — the small pure-Python engine deps
#                 (PyYAML/Jinja2/MarkupSafe). This directory IS committed to git so the
#                 control-node scripts import with zero pip/PyPI access. Run after bumping
#                 a pin in requirements.txt.
#
#   2. `bundle`   build the HEAVY offline bundle for baking into the kit IMAGE (NOT git):
#                   vendor/wheels/       pip wheels for requirements.txt (+ ansible-core, pywinrm[kerberos])
#                   vendor/collections/  Ansible Galaxy collection tarballs from requirements.yml
#                 Then `bin/bootstrap --offline` installs everything from here with no network.
#
# `all` does both. Run this on an internet-connected build host, then rebuild the kit image.
#
# OS packages (krb5-user/krb5-workstation, chrony) are the image's responsibility — see
# design §3.1 — and are documented in systemd/README.md, not bundled here.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

PY="${PYTHON:-python3}"
command -v "$PY" >/dev/null 2>&1 || PY=python

log() { printf '\033[1;36m[vendor-deps]\033[0m %s\n' "$*"; }
die() { printf '\033[1;31m[vendor-deps] ERROR:\033[0m %s\n' "$*" >&2; exit 1; }

vendor_python() {
  log "Rebuilding vendor/python/ (pure-Python engine deps) from requirements.txt"
  rm -rf vendor/python
  mkdir -p vendor/python
  "$PY" -m pip install --quiet --no-compile --target vendor/python -r requirements.txt
  # Strip platform-specific compiled extensions so the tree is pure-Python and portable;
  # PyYAML/MarkupSafe fall back to their Python implementations when the C ext is absent.
  find vendor/python \( -name '*.pyd' -o -name '*.so' \) -delete
  find vendor/python -type d -name '__pycache__' -prune -exec rm -rf {} + 2>/dev/null || true
  rm -rf vendor/python/bin
  log "vendor/python/ rebuilt ($(du -sh vendor/python | cut -f1)). Commit it."
}

vendor_bundle() {
  log "Building offline wheel bundle -> vendor/wheels/ (for the kit image, gitignored)"
  mkdir -p vendor/wheels
  # Engine deps + Ansible control node + the Kerberos WinRM stack (design §3.1).
  "$PY" -m pip download -d vendor/wheels \
    -r requirements.txt \
    "ansible-core>=2.16,<2.18" \
    "pywinrm[kerberos]>=0.4.3"
  log "wheels: $(ls vendor/wheels | wc -l) files, $(du -sh vendor/wheels | cut -f1)"

  log "Downloading Ansible collection tarballs -> vendor/collections/ (for the kit image, gitignored)"
  mkdir -p vendor/collections
  if command -v ansible-galaxy >/dev/null 2>&1; then
    ansible-galaxy collection download -r requirements.yml -p vendor/collections
    log "collections downloaded ($(du -sh vendor/collections | cut -f1)); resolved list in vendor/collections/requirements.yml"
  else
    die "ansible-galaxy not found — install ansible-core first (pip install ansible-core), then re-run 'bundle'"
  fi
}

case "${1:-all}" in
  python)  vendor_python ;;
  bundle)  vendor_bundle ;;
  all)     vendor_python; vendor_bundle ;;
  *) die "usage: bin/vendor-deps [python|bundle|all]" ;;
esac
log "done."

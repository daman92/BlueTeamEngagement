#!/usr/bin/env bash
# bootstrap — stand up the driftwatch control-node environment on the kit.
#
#   bin/bootstrap            online:  create .venv, pip install from PyPI, galaxy install collections
#   bin/bootstrap --offline  air-gapped: install ONLY from the bundle built by bin/vendor-deps
#                            (vendor/wheels + vendor/collections) — no network touched
#
# The Python ENGINE (scripts/) needs no venv at all: vendor/python/ is committed and
# scripts/_vendor.py puts it on sys.path, so `python scripts/diff_engine.py ...` runs on a
# bare Python 3.11+. This bootstrap is for running ANSIBLE (collection-based collection) and
# the dev/test tooling.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"
PY="${PYTHON:-python3}"; command -v "$PY" >/dev/null 2>&1 || PY=python
OFFLINE=0; [ "${1:-}" = "--offline" ] && OFFLINE=1

log() { printf '\033[1;36m[bootstrap]\033[0m %s\n' "$*"; }

log "Creating .venv"
"$PY" -m venv .venv
VPY=".venv/bin/python"; [ -x "$VPY" ] || VPY=".venv/Scripts/python"   # Linux vs Windows layout

if [ "$OFFLINE" = "1" ]; then
  log "OFFLINE install from vendor/wheels + vendor/collections"
  [ -d vendor/wheels ] || { echo "vendor/wheels missing — run bin/vendor-deps bundle on a connected host first" >&2; exit 1; }
  "$VPY" -m pip install --no-index --find-links vendor/wheels -r requirements.txt "ansible-core"
  ANSIBLE_GALAXY=".venv/bin/ansible-galaxy"; [ -x "$ANSIBLE_GALAXY" ] || ANSIBLE_GALAXY=".venv/Scripts/ansible-galaxy"
  "$ANSIBLE_GALAXY" collection install -r requirements.yml -p ./collections \
      --no-deps -s "$(ls -d vendor/collections)" 2>/dev/null || \
      "$ANSIBLE_GALAXY" collection install vendor/collections/*.tar.gz -p ./collections
else
  log "ONLINE install from PyPI + Galaxy"
  "$VPY" -m pip install --upgrade pip
  "$VPY" -m pip install -r requirements.txt ansible-core
  ANSIBLE_GALAXY=".venv/bin/ansible-galaxy"; [ -x "$ANSIBLE_GALAXY" ] || ANSIBLE_GALAXY=".venv/Scripts/ansible-galaxy"
  "$ANSIBLE_GALAXY" collection install -r requirements.yml -p ./collections
fi

log "done. Collections in ./collections (ansible.cfg already points there)."
log "The Python engine also runs standalone via vendor/python/ — no venv required for scripts/."

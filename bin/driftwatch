#!/usr/bin/env bash
#
# driftwatch — operator console for the blue-team baseline & drift-detection kit.
# One vocabulary the operator learns; underneath, the read-only collector and the
# response layer stay separate privilege domains that meet only at the case (design §14).
#
# Runs on the Linux kit control node. Verbs (CONTRACTS.md §8):
#   doctor [--json]                environment self-check: kit deps, Kerberos prereqs and
#                                    engagement readiness, each with its fix (design App. D.3)
#   new-engagement <id> [-i]       create an engagement volume from the template
#                                    (-i/--interactive: guided, validated scope.yml authoring)
#   preflight                      Kerberos prereqs + Windows transport matrix
#   collect [--deep] [--limit P]   scope-gate -> snapshot -> diff -> report
#   diff [--run-id R]              normalize + diff engine on the control node
#   report [--run-id R]            render Markdown + HTML report
#   ship [--run-id R]              push findings to the kit SIEM (Splunk/Security Onion)
#   baseline promote <host> <run_id> [--ticket T]
#   respond <propose|approve|rollback> ...   thin passthrough to the response layer
#   gui [--port N] [--no-browser]  local-only (127.0.0.1) operator GUI; no response/teardown
#   status                         read-only engagement dashboard
#   teardown [--retain a,b,...]    shred the volume (report kept by default; vault ALWAYS)
#
# Engagement is resolved from `--engagement <id>` or $DRIFTWATCH_ENGAGEMENT; it is an
# ERROR to have neither (the tool never guesses which client it is pointed at).
set -euo pipefail

# --------------------------------------------------------------------------- locations
SELF="$(cd "$(dirname "$0")" >/dev/null 2>&1 && pwd)/$(basename "$0")"
BIN_DIR="$(dirname "$SELF")"
REPO_ROOT="$(cd "$BIN_DIR/.." >/dev/null 2>&1 && pwd)"
SCRIPTS_DIR="$REPO_ROOT/scripts"
PLAYBOOKS_DIR="$REPO_ROOT/playbooks"
RULES_DIR="$REPO_ROOT/rules"
ALLOWLISTS_DIR="$REPO_ROOT/allowlists"
RESPOND_PY="$REPO_ROOT/response/scripts/respond.py"
export ANSIBLE_CONFIG="${ANSIBLE_CONFIG:-$REPO_ROOT/ansible.cfg}"

PROG="driftwatch"
OPERATOR="${DRIFTWATCH_OPERATOR:-$(id -un 2>/dev/null || echo unknown)}"

# Per-invocation scratch, always cleaned up (may hold resolved target IPs).
DW_TMP="$(mktemp -d "${TMPDIR:-/tmp}/driftwatch.XXXXXX")"
cleanup() { rm -rf "$DW_TMP"; }
trap cleanup EXIT

ENGAGEMENT=""
ENGAGEMENT_DIR=""

# --------------------------------------------------------------------------- output
_tty() { [ -t 2 ]; }
_col() { if _tty; then printf '\033[%sm' "$1" >&2; fi; }
info() { _col '0;36'; printf '[%s] ' "$PROG" >&2; _col '0'; printf '%s\n' "$*" >&2; }
warn() { _col '0;33'; printf '[%s] WARN: ' "$PROG" >&2; _col '0'; printf '%s\n' "$*" >&2; }
err()  { _col '0;31'; printf '[%s] ERROR: ' "$PROG" >&2; _col '0'; printf '%s\n' "$*" >&2; }
die()  { err "$*"; exit 1; }

iso_now()     { date -u +%Y-%m-%dT%H:%M:%SZ; }
make_run_id() { date -u +%Y-%m-%dT%H%MZ; }   # one collection cycle = one run_id fleet-wide

require_cmds() {
  local missing=()
  local c
  for c in "$@"; do command -v "$c" >/dev/null 2>&1 || missing+=("$c"); done
  [ "${#missing[@]}" -eq 0 ] || die "required command(s) not found on the kit: ${missing[*]}"
}

# --------------------------------------------------------------------------- engagement
resolve_engagement() {
  [ -n "$ENGAGEMENT" ] || ENGAGEMENT="${DRIFTWATCH_ENGAGEMENT:-}"
  [ -n "$ENGAGEMENT" ] || die "no engagement selected — pass --engagement <id> or set DRIFTWATCH_ENGAGEMENT"
  ENGAGEMENT_DIR="$REPO_ROOT/engagements/$ENGAGEMENT"
  [ -d "$ENGAGEMENT_DIR" ] || die "engagement '$ENGAGEMENT' not found at $ENGAGEMENT_DIR (create it with: $PROG new-engagement $ENGAGEMENT)"
  export DRIFTWATCH_ENGAGEMENT="$ENGAGEMENT"
  export DRIFTWATCH_ENGAGEMENT_DIR="$ENGAGEMENT_DIR"
}

# audit.log: one line per verb — "<ISO8601> | <verb> | <run_id> | <operator> | <outcome>"
audit() {
  local verb="$1" run_id="$2" outcome="$3"
  [ -n "$ENGAGEMENT_DIR" ] || return 0
  printf '%s | %s | %s | %s | %s\n' "$(iso_now)" "$verb" "$run_id" "$OPERATOR" "$outcome" \
    >>"$ENGAGEMENT_DIR/audit.log"
}

# Read a dotted path out of scope.yml with a default. PyYAML is a control-node dependency,
# but on an air-gapped kit it may only exist as the committed vendor/python copy — so fall
# back to it exactly like scripts/_vendor.py does. Without this the except-branch below
# silently hands back the DEFAULT: `collect` would run `tiered` hashing on a scope.yml that
# says `full` (a real detection gap, Appendix C.2), and SIEM shipping would quietly disable
# itself. A wrong answer here is worse than a loud failure.
scope_get() {
  python3 - "$ENGAGEMENT_DIR/scope.yml" "$1" "${2:-}" "$REPO_ROOT/vendor/python" <<'PY'
import sys
sys.path.append(sys.argv[4])          # offline kit: vendored PyYAML fallback (CONTRACTS §1.1)
try:
    import yaml
    d = yaml.safe_load(open(sys.argv[1], encoding="utf-8")) or {}
except Exception:
    print(sys.argv[3]); sys.exit(0)
cur = d
for part in sys.argv[2].split("."):
    if isinstance(cur, dict) and part in cur:
        cur = cur[part]
    else:
        cur = None
        break
print(sys.argv[3] if cur is None else cur)
PY
}

# Latest run_id in this engagement (run_ids sort lexicographically = chronologically).
latest_run_id() {
  local d="$ENGAGEMENT_DIR/snapshots/_run"
  [ -d "$d" ] || return 0
  local f
  f="$(ls "$d"/*.json 2>/dev/null | sort | tail -n1 || true)"
  [ -n "$f" ] || return 0
  basename "$f" .json
}

# --------------------------------------------------------------------------- target resolution
# Resolve the hosts matching an Ansible pattern to a JSON list of {name, ip}, using the
# host's ansible_host (the scope IP). scope_gate keys off IPs and fails closed on anything
# it cannot prove is in scope, so a host without an IP simply aborts the run — as intended.
build_targets_file() {
  local pattern="${1:-all}" out="$2"
  local inv="$ENGAGEMENT_DIR/inventory/hosts.yml"
  [ -f "$inv" ] || die "no inventory at $inv — run: python3 $SCRIPTS_DIR/scope_gate.py generate --engagement-dir $ENGAGEMENT_DIR"

  local listing=""
  listing="$(ansible "$pattern" -i "$inv" --list-hosts 2>/dev/null || true)"
  printf '%s\n' "$listing" | awk 'NR>1 && NF {print $1}' >"$DW_TMP/_hostnames"

  ansible-inventory -i "$inv" --list >"$DW_TMP/_inv.json" 2>/dev/null || echo '{}' >"$DW_TMP/_inv.json"

  python3 - "$DW_TMP/_hostnames" "$DW_TMP/_inv.json" "$out" <<'PY'
import json, sys
hosts = [ln.strip() for ln in open(sys.argv[1], encoding="utf-8") if ln.strip()]
try:
    inv = json.load(open(sys.argv[2], encoding="utf-8"))
except Exception:
    inv = {}
hv = inv.get("_meta", {}).get("hostvars", {})
# Direct group membership per host (used later to tell host-snapshot assets apart from
# AD-enrichment-only hosts). scope_gate ignores keys other than ip/name.
groups_by_host = {}
for gname, gdata in inv.items():
    if gname in ("_meta", "all") or not isinstance(gdata, dict):
        continue
    for h in gdata.get("hosts", []) or []:
        groups_by_host.setdefault(h, set()).add(gname)
targets = [{"name": h,
            "ip": (hv.get(h, {}).get("ansible_host") or h),
            "groups": sorted(groups_by_host.get(h, []))} for h in hosts]
json.dump(targets, open(sys.argv[3], "w", encoding="utf-8"))
print(len(targets))
PY
}

# Run the scope pre-flight gate (layer 2) over a target file BEFORE any play. Any target
# not affirmatively in-scope aborts the whole run and is appended to audit.log by scope_gate.
scope_gate_or_abort() {
  local targets="$1" verb="$2" run_id="$3"
  if ! python3 "$SCRIPTS_DIR/scope_gate.py" assert-run \
        --engagement-dir "$ENGAGEMENT_DIR" --targets-file "$targets" --operator "$OPERATOR"; then
    audit "$verb" "$run_id" "SCOPE-ABORT"
    die "scope gate refused this run — out-of-scope or ambiguous target(s); see audit.log"
  fi
}

# Build snapshots/_run/<run_id>.json from the play recap + snapshot meta + transport matrix.
# Schema is exactly what diff_engine.coverage_gaps() consumes.
build_run_status() {
  local run_id="$1" targets="$2" recap="$3"
  python3 - "$ENGAGEMENT_DIR" "$run_id" "$targets" "$recap" <<'PY'
import glob, json, os, re, sys
from datetime import datetime, timezone

eng_dir, run_id, targets_path, recap_path = sys.argv[1:5]
snap = os.path.join(eng_dir, "snapshots")
tm_path = os.path.join(eng_dir, "preflight", "transport_matrix.json")

targets = json.load(open(targets_path, encoding="utf-8"))
names = [t["name"] for t in targets]

# Group membership per host: union of the scope-declared groups (fleet_groups.json — the
# authoritative Python-side map, CONTRACTS §1.2) and the direct groups captured from the
# inventory listing. Drives the platform label on coverage-gap findings (must be one of
# linux|windows|network|ad) and tells host-snapshot assets apart from AD-enrichment-only
# hosts, whose document lives at snapshots/_domain_<fqdn>/, not snapshots/<host>/.
try:
    fleet_groups = json.load(open(os.path.join(eng_dir, "inventory", "fleet_groups.json"),
                                  encoding="utf-8"))
except Exception:
    fleet_groups = {}
groups_by_name = {t["name"]: set(t.get("groups") or []) | set(fleet_groups.get(t["name"], []))
                  for t in targets}

def platform_of(groups):
    for g in ("network", "windows", "linux", "ad"):
        if g in groups:
            return g
    return "linux"   # diff_engine's own default for hosts with no platform group

ad_only = {n for n in names
           if "ad" in groups_by_name.get(n, set())
           and not ({"linux", "windows", "network"} & groups_by_name.get(n, set()))}
domain_docs = sorted(glob.glob(os.path.join(snap, "_domain_*", run_id + ".json")))

# Parse the Ansible PLAY RECAP lines for unreachable/failed counts.
recap = {}
if os.path.exists(recap_path):
    txt = open(recap_path, encoding="utf-8", errors="replace").read()
    for m in re.finditer(r'^(\S+)\s*:\s*ok=\d+.*?unreachable=(\d+).*?failed=(\d+)', txt, re.M):
        recap[m.group(1)] = {"unreachable": int(m.group(2)), "failed": int(m.group(3))}

# Transport matrix -> hosts with no viable transport (kept out of the plain unreachable
# bucket so the report distinguishes "no path" from "we have a path but it broke").
no_transport = []
tm = {}
if os.path.exists(tm_path):
    try:
        tm = json.load(open(tm_path, encoding="utf-8")).get("hosts", {})
    except Exception:
        tm = {}
for h, meta in tm.items():
    if meta.get("transport") == "unreachable" and h in names:
        no_transport.append(h)

hosts = {}
t3_only = []
for name in names:
    if name in no_transport:
        continue
    snap_file = os.path.join(snap, name, run_id + ".json")
    if os.path.exists(snap_file):
        try:
            meta = json.load(open(snap_file, encoding="utf-8")).get("meta", {})
        except Exception:
            meta = {}
        platform = meta.get("platform", "linux")
        if meta.get("partial"):
            hosts[name] = {"status": "partial", "platform": platform,
                           "failed_categories": meta.get("failed_categories", [])}
        else:
            hosts[name] = {"status": "ok", "platform": platform, "failed_categories": []}
        if platform == "network" and meta.get("collection_tier") == "T3":
            t3_only.append(name)
    elif name in ad_only:
        # AD-enrichment-only host: its output is the per-domain document at
        # snapshots/_domain_<fqdn>/<run_id>.json (CONTRACTS §2), never snapshots/<host>/.
        if len(ad_only) == 1 and len(domain_docs) == 1:
            try:
                meta = json.load(open(domain_docs[0], encoding="utf-8")).get("meta", {})
            except Exception:
                meta = {}
            if meta.get("partial"):
                hosts[name] = {"status": "partial", "platform": "ad",
                               "failed_categories": meta.get("failed_categories", [])}
            else:
                hosts[name] = {"status": "ok", "platform": "ad", "failed_categories": []}
        elif domain_docs:
            # Multiple domains this run: a host<->domain mapping is ambiguous here, but at
            # least one enrichment document exists — report collection as achieved.
            hosts[name] = {"status": "ok", "platform": "ad", "failed_categories": []}
        else:
            hosts[name] = {"status": "unreachable", "platform": "ad", "failed_categories": []}
    else:
        # No snapshot produced and no declared no-transport => unreachable at collection time.
        hosts[name] = {"status": "unreachable",
                       "platform": platform_of(groups_by_name.get(name, set())),
                       "failed_categories": []}

out = {
    "run_id": run_id,
    "engagement": os.path.basename(eng_dir),
    "generated_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    "hosts": hosts,
    "no_transport": sorted(set(no_transport)),
    "t3_only": sorted(set(t3_only)),
}
os.makedirs(os.path.join(snap, "_run"), exist_ok=True)
with open(os.path.join(snap, "_run", run_id + ".json"), "w", encoding="utf-8", newline="\n") as fh:
    json.dump(out, fh, indent=2, sort_keys=True)

ok = sum(1 for v in hosts.values() if v["status"] == "ok")
partial = sum(1 for v in hosts.values() if v["status"] == "partial")
unreach = sum(1 for v in hosts.values() if v["status"] == "unreachable")
print(f"ok={ok} partial={partial} unreachable={unreach} "
      f"no_transport={len(no_transport)} t3_only={len(set(t3_only))}")
PY
}

# --------------------------------------------------------------------------- control-node pipeline
do_diff() {
  local run_id="$1"
  [ -n "$run_id" ] || die "diff: no run to diff (collect first, or pass --run-id)"
  require_cmds python3
  info "normalize + diff for run $run_id"
  python3 "$SCRIPTS_DIR/normalize.py" normalize --engagement-dir "$ENGAGEMENT_DIR" --run-id "$run_id"
  python3 "$SCRIPTS_DIR/diff_engine.py" run --engagement-dir "$ENGAGEMENT_DIR" --run-id "$run_id" \
    --rules-dir "$RULES_DIR" --allowlists-dir "$ALLOWLISTS_DIR"
}

do_report() {
  local run_id="$1"
  [ -n "$run_id" ] || die "report: no run to render (collect first, or pass --run-id)"
  require_cmds python3
  info "render report for run $run_id"
  python3 "$SCRIPTS_DIR/report_gen.py" render --engagement-dir "$ENGAGEMENT_DIR" --run-id "$run_id" --format md,html
  info "report written: $ENGAGEMENT_DIR/reports/$run_id.md (+ .html)"
}

# --------------------------------------------------------------------------- verbs
write_scope_template() {
  local path="$1" id="$2"
  cat >"$path" <<EOF
# driftwatch engagement scope — THE authorization rail (CONTRACTS.md §1.4, design §15.2).
# Hosts enter the inventory ONLY via in_scope. Fail-closed: an empty in_scope authorizes
# nothing. Fill this out, then generate the inventory:
#   python3 scripts/scope_gate.py generate --engagement-dir engagements/$id
engagement: $id
client: "CHANGE ME — Client legal name"
authorized_by: "CHANGE ME — name, title, signed SOW reference + date"   # free text, REQUIRED

in_scope:                       # ONLY source of inventory. CIDRs declare a range; host/ip
                                # entries become addressable machines. Discovery != access:
                                # add a discovered host here deliberately before touching it.
  # - cidr: 10.10.0.0/16
  #   groups: [linux]
  # - host: dc01.$id.example
  #   ip: 10.10.1.5
  #   groups: [windows, win_servers, ad, crown_jewels]

deny:                           # explicit never-touch; wins over in_scope
  # - cidr: 10.10.99.0/24

oob_subnets: []                 # devices NOT in these are assumed in-band (design §13.5)

settings:
  hash_policy: tiered           # full | tiered | servers_only  (Appendix C.2)
  collector_account: svc-driftwatch     # tagged collector_self by the normalizer
  outlier_max_prevalence: 0.05  # fleet-outlier: item on < 5% ...
  outlier_min_group: 20         #   ... of a group with >= 20 members
  fast_interval: 2h             # informational; systemd timers document their own cadence
  deep_interval: 24h
  splunk_hec_url: ""            # empty = Splunk shipping disabled
  splunk_hec_token_var: vault_splunk_hec_token   # NAME of the vault var, never the secret
  elastic_url: ""              # empty = Security Onion / Elastic shipping disabled
EOF
}

# Write a scope.yml the wizard has already filled in. Same schema, key order and comment
# weight as write_scope_template (CONTRACTS §1.4) — the differences are that every value is
# real (nothing says "CHANGE ME", so the engagement is runnable as written) and that the
# engagement id is emitted as a QUOTED scalar: the id is operator input here, and a bare
# plain scalar would let YAML resolve e.g. `yes` to a boolean, which then travels into
# findings[].engagement (CONTRACTS §4) as the wrong type.
# args: <path> <id> <client> <authorized_by> <in_scope_block> <deny_block> <oob_block>
#       <hash_policy> <collector_account>   (the *_block args arrive as rendered YAML)
write_scope_filled() {
  local path="$1" id="$2" client="$3" authorized_by="$4"
  local in_scope_block="$5" deny_block="$6" oob_block="$7"
  local hash_policy="$8" collector="$9"
  # Pad the two variable-width settings so their comments land in the same columns as the
  # template's — this file is read by humans under time pressure on an engagement. The pad
  # width is one short of the target column plus a LITERAL space, so an over-long value
  # still leaves the '#' whitespace-separated: `value# comment` is not a YAML comment.
  local hash_line collector_line
  hash_line="$(printf '  hash_policy: %-16s # full | tiered | servers_only  (Appendix C.2)' "$hash_policy")"
  collector_line="$(printf '  collector_account: %-18s # tagged collector_self by the normalizer' "\"$collector\"")"
  cat >"$path" <<EOF
# driftwatch engagement scope — THE authorization rail (CONTRACTS.md §1.4, design §15.2).
# Authored by \`$PROG new-engagement --interactive\` at $(iso_now) by $OPERATOR.
# Hosts enter the inventory ONLY via in_scope. Fail-closed: an empty in_scope authorizes
# nothing. After any edit, regenerate the inventory:
#   python3 scripts/scope_gate.py generate --engagement-dir engagements/$id
engagement: "$id"
client: "$client"
authorized_by: "$authorized_by"   # free text, REQUIRED — names the signed authorization

in_scope:                       # ONLY source of inventory. CIDRs declare a range; host/ip
                                # entries become addressable machines. Discovery != access:
                                # add a discovered host here deliberately before touching it.
$in_scope_block

$deny_block

$oob_block

settings:
$hash_line
$collector_line
  outlier_max_prevalence: 0.05  # fleet-outlier: item on < 5% ...
  outlier_min_group: 20         #   ... of a group with >= 20 members
  fast_interval: 2h             # informational; systemd timers document their own cadence
  deep_interval: 24h
  splunk_hec_url: ""            # empty = Splunk shipping disabled
  splunk_hec_token_var: vault_splunk_hec_token   # NAME of the vault var, never the secret
  elastic_url: ""              # empty = Security Onion / Elastic shipping disabled
EOF
}

# The engagement volume skeleton (CONTRACTS §1.2). Split out of cmd_new_engagement so the
# non-interactive and interactive paths create byte-identical directory trees.
create_engagement_volume() {
  local dir="$1"
  mkdir -p \
    "$dir/inventory" "$dir/vault" "$dir/preflight" \
    "$dir/snapshots/_run" "$dir/configs" "$dir/baselines" \
    "$dir/findings" "$dir/cases" "$dir/evidence" "$dir/reports" \
    "$dir/audit/hostlogs"
  chmod 700 "$dir/vault"                 # credentials never leave this directory
  : >"$dir/audit.log"

  # Per-engagement git repo for tamper-evident snapshot history (design §5). It lives INSIDE
  # the engagement volume (which the root .gitignore excludes), so it is shredded with the
  # volume at teardown and never mixes with the tool repo's history.
  if command -v git >/dev/null 2>&1; then
    ( cd "$dir" \
        && git init -q \
        && printf 'vault/\n.factcache/\n.retry/\n*.lock\n' >.gitignore \
    ) || warn "per-engagement git init failed (non-fatal — tamper-evidence history unavailable)"
  fi
}

cmd_new_engagement() {
  local id="" interactive=false
  while [ $# -gt 0 ]; do
    case "$1" in
      -i|--interactive) interactive=true; shift ;;
      -*)               die "new-engagement: unknown option '$1'" ;;
      *)                if [ -n "$id" ]; then die "new-engagement: unexpected extra argument '$1'"; fi
                        id="$1"; shift ;;
    esac
  done

  if [ "$interactive" = true ]; then
    new_engagement_interactive "$id"
    return 0
  fi

  [ -n "$id" ] || die "usage: $PROG new-engagement [-i|--interactive] <engagement_id>   (format: <client>-<yyyy>-<mm>, e.g. acme-2026-07)"
  printf '%s' "$id" | grep -Eq '^[A-Za-z0-9]([A-Za-z0-9_-]*[A-Za-z0-9])?-[0-9]{4}-[0-9]{2}$' \
    || warn "engagement id '$id' does not match <client>-<yyyy>-<mm> — continuing anyway"

  local dir="$REPO_ROOT/engagements/$id"
  [ -e "$dir" ] && die "engagement already exists: $dir"

  create_engagement_volume "$dir"
  write_scope_template "$dir/scope.yml" "$id"

  ENGAGEMENT="$id"; ENGAGEMENT_DIR="$dir"
  audit "new-engagement" "-" "created"
  info "created engagement volume: $dir"
  cat >&2 <<EOF

Next steps:
  1. Edit ${dir#$REPO_ROOT/}/scope.yml — set authorized_by and in_scope (this IS the authorization boundary).
     (or re-run with --interactive next time and answer the prompts instead)
  2. Load the handed-over credentials into the ephemeral vault:
       ansible-vault create ${dir#$REPO_ROOT/}/vault/vault.yml
  3. Generate the fail-closed inventory from scope:
       python3 scripts/scope_gate.py generate --engagement-dir ${dir#$REPO_ROOT/}
  4. Verify transports (DNS/clock/TGT + WinRM/OpenSSH):
       DRIFTWATCH_ENGAGEMENT=$id $PROG preflight
EOF
}

# ---- new-engagement --interactive: the guided path ------------------------------------
# Prompts go to STDERR and answers are read from STDIN one line at a time, so the wizard
# behaves identically when stdin is a tty, a pipe or a heredoc — no `read -p`, no readline,
# no tty requirement. Running out of input is one explicit failure: never a silent default,
# never a loop.
ANS=""
WIZ_ON_EOF="fatal"     # flipped to "default" once the volume exists (nothing to unwind then)

wiz_ask() {
  local prompt="$1" default="${2:-}"
  if [ -n "$default" ]; then
    printf '  %s [%s]: ' "$prompt" "$default" >&2
  else
    printf '  %s: ' "$prompt" >&2
  fi
  if ! IFS= read -r ANS; then
    printf '\n' >&2
    if [ "$WIZ_ON_EOF" = "default" ]; then
      ANS="$default"
      warn "end of input — taking the default '$default' for \"$prompt\""
      return 0
    fi
    die "interactive: stdin closed while answering \"$prompt\" — nothing has been written"
  fi
  # Trim: a piped answer file may carry CR (CRLF) or padding. An empty answer takes the default.
  ANS="${ANS#"${ANS%%[![:space:]]*}"}"
  ANS="${ANS%"${ANS##*[![:space:]]}"}"
  [ -n "$ANS" ] || ANS="$default"
  # On a tty the operator's own Enter closes the line; from a pipe nothing is echoed, so
  # mirror the effective answer to keep the transcript (and any test log) readable.
  if [ ! -t 0 ]; then printf '%s\n' "$ANS" >&2; fi
  return 0
}

wiz_yn() {   # <prompt> <y|n default> — 0 = yes, 1 = no
  local prompt="$1" default="${2:-n}"
  while : ; do
    wiz_ask "$prompt (y/n)" "$default"
    case "$ANS" in
      y|Y|yes|Yes|YES) return 0 ;;
      n|N|no|No|NO)    return 1 ;;
      *) warn "answer y or n" ;;
    esac
  done
}

# Validate addresses with the SAME ipaddress module scope_gate.py uses, so the wizard can
# never author a scope.yml that `scope_gate generate` would then reject.
wiz_valid_net() { python3 -c 'import ipaddress,sys; ipaddress.ip_network(sys.argv[1], strict=False)' "$1" >/dev/null 2>&1; }
wiz_valid_ip()  { python3 -c 'import ipaddress,sys; ipaddress.ip_address(sys.argv[1])' "$1" >/dev/null 2>&1; }
wiz_valid_host() { printf '%s' "$1" | grep -Eq '^[A-Za-z0-9]([A-Za-z0-9._-]*[A-Za-z0-9])?$'; }

# "windows, win_servers ad" -> "windows, win_servers, ad" (a YAML flow-list body). Returns
# non-zero on anything that is not a plain ansible group name, so the caller re-prompts.
wiz_groups() {
  local raw="${1//,/ }" out="" g
  local words=()
  # Word-split with pathname expansion OFF. An answer of '*' is not a group name and must be
  # REFUSED; with globbing on, bash would expand it against the operator's cwd and those
  # filenames would land in the authorization file as ansible groups.
  local had_noglob=false
  case "$-" in *f*) had_noglob=true ;; esac
  set -f
  # shellcheck disable=SC2206  # deliberate split; globbing is disabled for exactly this line
  words=($raw)
  [ "$had_noglob" = true ] || set +f
  for g in ${words[@]+"${words[@]}"}; do
    printf '%s' "$g" | grep -Eq '^[A-Za-z0-9_][A-Za-z0-9_-]*$' || return 1
    if [ -n "$out" ]; then out="$out, $g"; else out="$g"; fi
  done
  [ -n "$out" ] || return 1
  printf '%s' "$out"
}

wiz_dq() {   # escape free text for a YAML double-quoted scalar
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  printf '%s' "$s"
}

# Everything is collected and confirmed BEFORE anything is written, so an abort — or a
# closed stdin — leaves no half-built engagement volume and no permissive scope.yml behind.
new_engagement_interactive() {
  local id="${1:-}"
  require_cmds python3

  cat >&2 <<EOF

$PROG new-engagement — guided setup.
scope.yml is the authorization rail (design §15.2): it is the record of what you were
permitted to touch, so every answer below lands in the operator's legal evidence. Nothing
is written until you confirm the summary at the end; Ctrl-C aborts.
EOF

  # ---- identity
  local dir="" id_default="$id"
  while : ; do
    wiz_ask "engagement id (<client>-<yyyy>-<mm>)" "$id_default"
    id="$ANS"
    id_default=""          # a rejected id must never come back as the offered default
    if [ -z "$id" ]; then warn "an engagement id is required"; continue; fi
    case "$id" in
      */*|.|..) warn "'$id' is not usable as a directory name"; continue ;;
    esac
    # The id becomes BOTH a directory name and a YAML scalar in scope.yml. Characters
    # outside this set (': ', '#', quotes, '[', '*', '&') produce a scope.yml that
    # scope_gate.py refuses to load — and this wizard exists precisely so that cannot
    # happen. So this one is a refusal, not a warning like the <client>-<yyyy>-<mm> shape.
    if ! printf '%s' "$id" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9._-]*$'; then
      warn "'$id' has characters outside [A-Za-z0-9._-] (and must start alphanumeric) — the id"
      warn "  names a directory and a YAML value; anything else breaks scope.yml"
      continue
    fi
    dir="$REPO_ROOT/engagements/$id"
    if [ -e "$dir" ]; then warn "engagement already exists: engagements/$id — pick another id"; continue; fi
    printf '%s' "$id" | grep -Eq '^[A-Za-z0-9]([A-Za-z0-9_-]*[A-Za-z0-9])?-[0-9]{4}-[0-9]{2}$' \
      || warn "engagement id '$id' does not match <client>-<yyyy>-<mm> — continuing anyway"
    break
  done

  local client=""
  wiz_ask "client legal name" "${id%%-*}"
  client="$ANS"

  # authorized_by is REQUIRED: design §15.2 derives scope from a signed authorization
  # document, and a scope.yml that cannot name its authorization is not one.
  local authorized_by=""
  while : ; do
    wiz_ask "authorized_by (name, title, signed SOW reference + date)" ""
    if [ -n "$ANS" ]; then authorized_by="$ANS"; break; fi
    warn "authorized_by is REQUIRED — it names the signed authorization this engagement runs under (design §15.2)"
  done

  # ---- in_scope (at least one entry: an empty in_scope authorizes nothing)
  cat >&2 <<'EOF'

in_scope — the ONLY source of inventory. A `cidr` entry authorizes a RANGE but makes no
machine addressable (discovery != access, design §15.2); a `host` entry becomes a machine
the kit will actually collect from. At least one entry is required.
EOF
  local in_scope_block="" scope_summary="" groups=""
  local n_cidr=0 n_host=0
  while : ; do
    local kind=""
    while : ; do
      wiz_ask "entry type (cidr/host)" "cidr"
      case "$ANS" in
        cidr|CIDR|c) kind="cidr"; break ;;
        host|HOST|h) kind="host"; break ;;
        *) warn "answer 'cidr' or 'host'" ;;
      esac
    done

    if [ "$kind" = "cidr" ]; then
      local cidr=""
      while : ; do
        wiz_ask "CIDR (e.g. 10.10.0.0/16)" ""
        if [ -n "$ANS" ] && wiz_valid_net "$ANS"; then cidr="$ANS"; break; fi
        warn "'$ANS' is not a valid network — expected e.g. 10.10.0.0/16"
      done
      while : ; do
        wiz_ask "ansible groups for this range (comma separated)" "linux"
        groups="$(wiz_groups "$ANS" || true)"
        if [ -n "$groups" ]; then break; fi
        warn "groups must be plain names, e.g. linux, win_servers, network"
      done
      in_scope_block="$in_scope_block  - cidr: $cidr"$'\n'"    groups: [$groups]"$'\n'
      scope_summary="$scope_summary                        range  $cidr  groups: [$groups]"$'\n'
      n_cidr=$((n_cidr + 1))
    else
      local hostname="" hostip=""
      while : ; do
        wiz_ask "hostname / FQDN (Kerberos resolves SPNs by name, never by IP — design §3.1)" ""
        if [ -n "$ANS" ] && wiz_valid_host "$ANS"; then hostname="$ANS"; break; fi
        warn "'$ANS' is not a valid hostname"
      done
      while : ; do
        wiz_ask "ip for $hostname" ""
        if [ -n "$ANS" ] && wiz_valid_ip "$ANS"; then hostip="$ANS"; break; fi
        warn "'$ANS' is not a valid IP address — the scope gate keys off IPs and fails closed without one"
      done
      while : ; do
        wiz_ask "ansible groups for $hostname (comma separated)" "windows"
        groups="$(wiz_groups "$ANS" || true)"
        if [ -n "$groups" ]; then break; fi
        warn "groups must be plain names, e.g. windows, win_servers, ad, crown_jewels"
      done
      in_scope_block="$in_scope_block  - host: $hostname"$'\n'"    ip: $hostip"$'\n'"    groups: [$groups]"$'\n'
      scope_summary="$scope_summary                        host   $hostname ($hostip)  groups: [$groups]"$'\n'
      n_host=$((n_host + 1))
    fi

    if ! wiz_yn "add another in_scope entry?" "n"; then break; fi
  done

  # ---- deny (optional; wins over in_scope)
  local deny_block="" deny_summary="" n_deny=0
  if wiz_yn "add explicit deny CIDRs (never-touch; wins over in_scope)?" "n"; then
    while : ; do
      wiz_ask "deny CIDR" ""
      if [ -n "$ANS" ] && wiz_valid_net "$ANS"; then
        deny_block="$deny_block  - cidr: $ANS"$'\n'
        if [ -n "$deny_summary" ]; then deny_summary="$deny_summary, $ANS"; else deny_summary="$ANS"; fi
        n_deny=$((n_deny + 1))
        if ! wiz_yn "add another deny CIDR?" "n"; then break; fi
      else
        warn "'$ANS' is not a valid network — expected e.g. 10.10.99.0/24"
      fi
    done
  fi

  # ---- oob_subnets (optional)
  cat >&2 <<'EOF'

oob_subnets — management networks reached OUT of band. Everything NOT listed here is
assumed IN-BAND, which is what makes the response layer warn before it cuts the path it is
talking over (design §13.5). Leave empty if there is no separate management network.
EOF
  local oob_block="" oob_summary="" n_oob=0
  if wiz_yn "add oob_subnets?" "n"; then
    while : ; do
      wiz_ask "oob subnet CIDR" ""
      if [ -n "$ANS" ] && wiz_valid_net "$ANS"; then
        oob_block="$oob_block  - $ANS"$'\n'
        if [ -n "$oob_summary" ]; then oob_summary="$oob_summary, $ANS"; else oob_summary="$ANS"; fi
        n_oob=$((n_oob + 1))
        if ! wiz_yn "add another oob subnet?" "n"; then break; fi
      else
        warn "'$ANS' is not a valid network — expected e.g. 192.168.99.0/24"
      fi
    done
  fi

  # ---- settings
  local hash_policy=""
  while : ; do
    wiz_ask "hash_policy (full|tiered|servers_only)" "tiered"
    case "$ANS" in
      full|tiered|servers_only) hash_policy="$ANS"; break ;;
      *) warn "hash_policy must be one of: full, tiered, servers_only (Appendix C.2)" ;;
    esac
  done
  local collector=""
  wiz_ask "collector_account (the handed-over account the kit collects with)" "svc-driftwatch"
  collector="$ANS"

  # ---- summary + explicit confirmation (nothing has been written yet)
  cat >&2 <<EOF

--- summary ---------------------------------------------------------------------
  engagement          : $id
  client              : $client
  authorized_by       : $authorized_by
  in_scope            : $n_cidr range(s), $n_host host(s)
${scope_summary%$'\n'}
  deny                : ${deny_summary:-(none)}
  oob_subnets         : ${oob_summary:-(none — every device is treated as in-band, §13.5)}
  hash_policy         : $hash_policy
  collector_account   : $collector
  volume              : engagements/$id
----------------------------------------------------------------------------------
EOF
  if [ "$n_host" -eq 0 ]; then
    warn "no host entries: CIDRs authorize the range but make nothing addressable"
    warn "  (discovery != access, design §15.2) — the generated inventory will be EMPTY until"
    warn "  you add host/ip entries for the machines you are actually collecting from"
  fi
  if ! wiz_yn "write this engagement volume now?" "y"; then
    die "aborted at the summary — nothing was written"
  fi

  # ---- write
  create_engagement_volume "$dir"
  WIZ_ON_EOF="default"    # the volume exists: a truncated stdin must not abort us mid-way

  # deny/oob render as explicit empty lists when unused: a bare `deny:` parses as null, and
  # `[]` reads as "considered, nothing to add" rather than "left unfinished".
  local deny_yaml oob_yaml
  if [ -n "$deny_block" ]; then
    deny_yaml="deny:                           # explicit never-touch; wins over in_scope
${deny_block%$'\n'}"
  else
    deny_yaml="deny: []                        # explicit never-touch; wins over in_scope"
  fi
  if [ -n "$oob_block" ]; then
    oob_yaml="oob_subnets:                    # devices NOT in these are assumed in-band (design §13.5)
${oob_block%$'\n'}"
  else
    oob_yaml="oob_subnets: []                 # devices NOT in these are assumed in-band (design §13.5)"
  fi

  write_scope_filled "$dir/scope.yml" "$id" "$(wiz_dq "$client")" "$(wiz_dq "$authorized_by")" \
    "${in_scope_block%$'\n'}" "$deny_yaml" "$oob_yaml" "$hash_policy" "$(wiz_dq "$collector")"

  ENGAGEMENT="$id"; ENGAGEMENT_DIR="$dir"
  audit "new-engagement" "-" "created interactive in_scope=$((n_cidr + n_host)) deny=$n_deny oob=$n_oob authorized_by=set"
  info "created engagement volume: $dir"
  info "scope.yml written: ${dir#$REPO_ROOT/}/scope.yml"

  if wiz_yn "generate the fail-closed inventory from this scope now?" "y"; then
    local rc=0
    python3 "$SCRIPTS_DIR/scope_gate.py" generate --engagement-dir "$dir" || rc=$?
    if [ "$rc" -ne 0 ]; then
      warn "scope_gate generate failed (rc=$rc) — fix scope.yml, then re-run:"
      warn "    python3 scripts/scope_gate.py generate --engagement-dir ${dir#$REPO_ROOT/}"
    fi
  else
    info "inventory not generated — run it before collecting:"
    info "    python3 scripts/scope_gate.py generate --engagement-dir ${dir#$REPO_ROOT/}"
  fi

  cat >&2 <<EOF

Next steps:
  1. Load the handed-over credentials into the ephemeral vault (design §15.3):
       ansible-vault create ${dir#$REPO_ROOT/}/vault/vault.yml
  2. Verify transports (DNS/clock/TGT + WinRM/OpenSSH):
       DRIFTWATCH_ENGAGEMENT=$id $PROG preflight
  3. Re-check readiness at any point:
       DRIFTWATCH_ENGAGEMENT=$id $PROG doctor
EOF
}

cmd_preflight() {
  resolve_engagement
  require_cmds ansible ansible-playbook ansible-inventory python3
  local run_id; run_id="$(make_run_id)"

  # Preflight probes Windows hosts, so it too passes through the scope gate first.
  build_targets_file "windows" "$DW_TMP/targets.json" >/dev/null
  scope_gate_or_abort "$DW_TMP/targets.json" "preflight" "$run_id"

  info "preflight run_id=$run_id — checking DNS-at-DC, clock skew (<5m), TGT, WinRM/OpenSSH"
  local rc=0
  ansible-playbook "$PLAYBOOKS_DIR/preflight.yml" \
    -i "$ENGAGEMENT_DIR/inventory/hosts.yml" \
    -e "dw_engagement=$ENGAGEMENT" \
    -e "dw_engagement_dir=$ENGAGEMENT_DIR" \
    -e "dw_run_id=$run_id" \
    || rc=$?

  if [ "$rc" -ne 0 ]; then
    audit "preflight" "$run_id" "prereq-fail rc=$rc"
    die "preflight FAILED — resolve the remediation items printed above before collecting"
  fi
  audit "preflight" "$run_id" "ok"
  info "transport matrix: $ENGAGEMENT_DIR/preflight/transport_matrix.json"
}

cmd_collect() {
  local deep=false limit="" collect_only=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --deep)                    deep=true; shift ;;
      --limit)                   limit="${2:-}"; [ -n "$limit" ] || die "--limit needs a PATTERN"; shift 2 ;;
      --limit=*)                 limit="${1#*=}"; shift ;;
      --collect-only|--no-report) collect_only=true; shift ;;
      *) die "collect: unknown option '$1'" ;;
    esac
  done

  resolve_engagement
  require_cmds ansible ansible-playbook ansible-inventory python3

  local run_id; run_id="$(make_run_id)"
  local hash_policy; hash_policy="$(scope_get settings.hash_policy tiered)"
  local pattern="${limit:-all}"

  # Prevent overlapping runs (systemd fast/deep/network timers can fire close together).
  if command -v flock >/dev/null 2>&1; then
    exec 9>"$ENGAGEMENT_DIR/.collect.lock"
    flock -n 9 || die "another collect is already running for '$ENGAGEMENT' (lock held)"
  fi

  # --- SCOPE GATE (layer 2) — BEFORE ANY PLAY ---
  build_targets_file "$pattern" "$DW_TMP/targets.json" >/dev/null
  scope_gate_or_abort "$DW_TMP/targets.json" "collect" "$run_id"

  local ev=(
    -e "dw_engagement=$ENGAGEMENT"
    -e "dw_engagement_dir=$ENGAGEMENT_DIR"
    -e "dw_run_id=$run_id"
    -e "dw_snapshot_dir=$ENGAGEMENT_DIR/snapshots"
    -e "dw_deep=$deep"
    -e "dw_hash_policy=$hash_policy"
    -e "dw_transport_matrix=$ENGAGEMENT_DIR/preflight/transport_matrix.json"
  )
  local limit_args=()
  [ -n "$limit" ] && limit_args=(--limit "$limit")

  local recap="$DW_TMP/recap.log"
  local overall_rc=0

  info "collect run_id=$run_id deep=$deep hash_policy=$hash_policy pattern=$pattern operator=$OPERATOR"

  # Host snapshots (linux / windows / ad).
  ansible-playbook "$PLAYBOOKS_DIR/snapshot.yml" \
    -i "$ENGAGEMENT_DIR/inventory/hosts.yml" "${ev[@]}" "${limit_args[@]}" \
    2>&1 | tee -a "$recap" || overall_rc=$?

  # Network snapshots.
  ansible-playbook "$PLAYBOOKS_DIR/snapshot_network.yml" \
    -i "$ENGAGEMENT_DIR/inventory/hosts.yml" "${ev[@]}" "${limit_args[@]}" \
    2>&1 | tee -a "$recap" || overall_rc=$?

  # Record the run status (drives coverage-gap findings in the diff engine).
  local summary
  summary="$(build_run_status "$run_id" "$DW_TMP/targets.json" "$recap")" || summary="(status build failed)"
  info "collection recap: $summary"
  audit "collect" "$run_id" "collected rc=$overall_rc $summary"

  if [ "$collect_only" = true ]; then
    info "collect-only: skipping diff/report"
    printf '%s\n' "$run_id"
    return 0
  fi

  do_diff "$run_id"
  do_report "$run_id"
  printf '%s\n' "$run_id"
}

cmd_diff() {
  resolve_engagement
  local run_id=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --run-id)   run_id="${2:-}"; shift 2 ;;
      --run-id=*) run_id="${1#*=}"; shift ;;
      *) die "diff: unknown argument '$1'" ;;
    esac
  done
  [ -n "$run_id" ] || run_id="$(latest_run_id)"
  [ -n "$run_id" ] || die "diff: no runs found — collect first"
  do_diff "$run_id"
  audit "diff" "$run_id" "ok"
}

cmd_report() {
  resolve_engagement
  local run_id=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --run-id)   run_id="${2:-}"; shift 2 ;;
      --run-id=*) run_id="${1#*=}"; shift ;;
      *) die "report: unknown argument '$1'" ;;
    esac
  done
  [ -n "$run_id" ] || run_id="$(latest_run_id)"
  [ -n "$run_id" ] || die "report: no runs found — collect first"
  do_report "$run_id"
  audit "report" "$run_id" "ok"
}

cmd_ship() {
  resolve_engagement
  local run_id=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --run-id)   run_id="${2:-}"; shift 2 ;;
      --run-id=*) run_id="${1#*=}"; shift ;;
      *) die "ship: unknown argument '$1'" ;;
    esac
  done
  [ -n "$run_id" ] || run_id="$(latest_run_id)"
  [ -n "$run_id" ] || die "ship: no runs found — collect first"
  require_cmds python3
  [ -f "$SCRIPTS_DIR/siem_ship.py" ] || die "siem_ship.py not present in $SCRIPTS_DIR"

  # Only ship to destinations that are actually configured in scope.yml. The token itself
  # is never on the command line — siem_ship reads it from env/vault (CONTRACTS.md §6).
  local splunk elastic flags=()
  splunk="$(scope_get settings.splunk_hec_url "")"
  elastic="$(scope_get settings.elastic_url "")"
  [ -n "$splunk" ]  && flags+=(--splunk)
  [ -n "$elastic" ] && flags+=(--elastic)
  if [ "${#flags[@]}" -eq 0 ]; then
    warn "shipping disabled — set settings.splunk_hec_url and/or settings.elastic_url in scope.yml"
    audit "ship" "$run_id" "noop-disabled"
    return 0
  fi

  python3 "$SCRIPTS_DIR/siem_ship.py" ship \
    --engagement-dir "$ENGAGEMENT_DIR" --run-id "$run_id" "${flags[@]}"
  audit "ship" "$run_id" "ok dest=${flags[*]}"
}

cmd_baseline() {
  local sub="${1:-}"
  [ "$sub" = "promote" ] || die "usage: $PROG baseline promote <host> <run_id> [--ticket T]"
  shift
  local host="${1:-}" run_id="${2:-}"
  [ -n "$host" ] && [ -n "$run_id" ] || die "usage: $PROG baseline promote <host> <run_id> [--ticket T]"
  shift 2
  local ticket=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --ticket)   ticket="${2:-}"; shift 2 ;;
      --ticket=*) ticket="${1#*=}"; shift ;;
      *) die "baseline: unknown argument '$1'" ;;
    esac
  done
  resolve_engagement
  require_cmds python3
  [ -f "$SCRIPTS_DIR/baseline.py" ] || die "baseline.py not present in $SCRIPTS_DIR"
  local t=()
  [ -n "$ticket" ] && t=(--ticket "$ticket")
  python3 "$SCRIPTS_DIR/baseline.py" promote \
    --engagement-dir "$ENGAGEMENT_DIR" --host "$host" --run-id "$run_id" "${t[@]}"
  audit "baseline" "$run_id" "promote host=$host ticket=${ticket:-none}"
}

cmd_respond() {
  # Thin passthrough to the response layer — a SEPARATE privilege domain (§7, §14). This
  # console forwards the verb and args verbatim; it never loads response credentials itself.
  resolve_engagement
  local sub="${1:-}"
  case "$sub" in
    propose|approve|rollback) ;;
    *) die "usage: $PROG respond <propose|approve|rollback> [args...]" ;;
  esac
  [ -f "$RESPOND_PY" ] || die "response layer not installed (missing $RESPOND_PY)"
  require_cmds python3
  export DRIFTWATCH_ENGAGEMENT DRIFTWATCH_ENGAGEMENT_DIR
  info "respond '$sub' -> response layer (evidence-first, human-gated; §13)"
  local rc=0
  python3 "$RESPOND_PY" "$@" || rc=$?
  audit "respond" "-" "$sub rc=$rc"
  return "$rc"
}

# Local-only operator GUI. Deliberately constrained (design §9, §13.6): the server binds
# 127.0.0.1 and nothing else, requires a per-run token on every request, and exposes NO
# response/approve, teardown, or credential surface — a kit holding fleet-wide admin creds
# does not get a web button for the write path. Engagement is optional here: the GUI can
# pick one (or run the setup wizard) once it is up.
cmd_gui() {
  require_cmds python3
  local gui_py="$SCRIPTS_DIR/gui_server.py"
  [ -f "$gui_py" ] || die "GUI not installed: $gui_py not found"

  # Pass --engagement through when one is already selected, so the GUI opens on it.
  local args=()
  if [ -n "$ENGAGEMENT" ] || [ -n "${DRIFTWATCH_ENGAGEMENT:-}" ]; then
    args+=(--engagement "${ENGAGEMENT:-$DRIFTWATCH_ENGAGEMENT}")
  fi

  info "starting the operator GUI on loopback (127.0.0.1) — Ctrl-C to stop"
  local rc=0
  python3 "$gui_py" serve ${args[@]+"${args[@]}"} "$@" || rc=$?
  return "$rc"
}

cmd_status() {
  resolve_engagement
  require_cmds python3
  local run_id; run_id="$(latest_run_id || true)"

  python3 - "$ENGAGEMENT_DIR" "$ENGAGEMENT" "${run_id:-}" "$REPO_ROOT/vendor/python" <<'PY'
import json, os, sys
eng_dir, engagement, run_id = sys.argv[1], sys.argv[2], sys.argv[3]
sys.path.append(sys.argv[4])          # offline kit: vendored PyYAML fallback (CONTRACTS §1.1)

def load_yaml(path):
    try:
        import yaml
        return yaml.safe_load(open(path, encoding="utf-8")) or {}
    except Exception:
        return {}

scope = load_yaml(os.path.join(eng_dir, "scope.yml"))
print(f"engagement : {engagement}")
print(f"client     : {scope.get('client', '(unset)')}")
print(f"authorized : {scope.get('authorized_by', '(unset)')}")

fg_path = os.path.join(eng_dir, "inventory", "fleet_groups.json")
if os.path.exists(fg_path):
    try:
        fg = json.load(open(fg_path, encoding="utf-8"))
        groups = {}
        for h, gs in fg.items():
            for g in gs:
                groups[g] = groups.get(g, 0) + 1
        print(f"inventory  : {len(fg)} host(s) across {len(groups)} group(s) "
              f"[{', '.join(f'{g}:{n}' for g, n in sorted(groups.items()))}]")
    except Exception:
        print("inventory  : (unreadable)")
else:
    print("inventory  : (not generated — run scope_gate generate)")

tm_path = os.path.join(eng_dir, "preflight", "transport_matrix.json")
if os.path.exists(tm_path):
    try:
        tm = json.load(open(tm_path, encoding="utf-8")).get("hosts", {})
        counts = {}
        for meta in tm.values():
            t = meta.get("transport", "?")
            counts[t] = counts.get(t, 0) + 1
        print(f"transports : {', '.join(f'{t}:{n}' for t, n in sorted(counts.items())) or '(none)'}")
    except Exception:
        print("transports : (unreadable)")
else:
    print("transports : (no preflight yet)")

print(f"latest run : {run_id or '(none)'}")
if run_id:
    rs_path = os.path.join(eng_dir, "snapshots", "_run", run_id + ".json")
    if os.path.exists(rs_path):
        rs = json.load(open(rs_path, encoding="utf-8"))
        hs = rs.get("hosts", {})
        by = {}
        for v in hs.values():
            by[v.get("status")] = by.get(v.get("status"), 0) + 1
        print(f"collection : {', '.join(f'{s}:{n}' for s, n in sorted(by.items())) or '(none)'}"
              f"  no_transport:{len(rs.get('no_transport', []))}  t3_only:{len(rs.get('t3_only', []))}")

    nd = os.path.join(eng_dir, "findings", run_id + ".ndjson")
    if os.path.exists(nd):
        sev = {}
        suppressed = 0
        total = 0
        for line in open(nd, encoding="utf-8"):
            line = line.strip()
            if not line:
                continue
            total += 1
            f = json.loads(line)
            if f.get("suppressed"):
                suppressed += 1
                continue
            sev[f.get("severity")] = sev.get(f.get("severity"), 0) + 1
        order = ["critical", "high", "medium", "low", "info"]
        pretty = ", ".join(f"{s}:{sev[s]}" for s in order if s in sev) or "(none active)"
        print(f"findings   : {pretty}   (total {total}, suppressed {suppressed})")
    else:
        print("findings   : (not diffed yet — run 'driftwatch diff')")
PY

  info "recent audit.log:"
  tail -n 6 "$ENGAGEMENT_DIR/audit.log" 2>/dev/null || true
}

# --------------------------------------------------------------------------- doctor
# Environment self-check. Design Appendix D.3 is explicit that this checklist must be a
# scripted verb that "fails loudly with specific remediation text, not diagnosed by hand" —
# so every non-PASS check carries the exact command that fixes it. "Kerberos is broken" is
# not a diagnosis; "kinit svc-dw@ACME.EXAMPLE" is. Checks probe defensively and NEVER abort
# the run: a missing tool is a result, not a crash. Exit 1 only when something FAILed.
DOC_ID=(); DOC_LABEL=(); DOC_STATUS=(); DOC_DETAIL=(); DOC_REMEDY=()
DOC_PASS=0; DOC_WARN=0; DOC_FAIL=0
DOC_JSON=false
DOC_PY=""              # python3 as found by the interpreter check; "" when unusable

# Collapse a value to one line: keeps the human table aligned and keeps --json escaping
# down to backslash + quote (below). The whole control class goes, not just CR/LF/TAB —
# detail text can carry an arbitrary byte out of scope.yml or a parser message, and RFC 8259
# forbids a raw control character inside a JSON string, so one would make --json unparseable.
_oneline() {
  local s="${1:-}"
  s="${s//[[:cntrl:]]/ }"
  while [ "$s" != "${s//  / }" ]; do s="${s//  / }"; done
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  printf '%s' "$s"
}

# Bash-only JSON escaping: --json must still work on a kit whose python3 is the very thing
# that is broken.
_json_escape() {
  local s="${1:-}"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  printf '%s' "$s"
}

doctor_section() {
  if [ "$DOC_JSON" = true ]; then return 0; fi
  printf '\n' >&2
  _col '1;37'; printf '  %s' "$1" >&2; _col '0'; printf '\n' >&2
  return 0
}

doctor_print() {   # <status> <label> <detail> <remediation>
  local status="$1" label="$2" detail="$3" remedy="$4" tag colour
  case "$status" in
    pass) tag="PASS"; colour='0;32' ;;
    warn) tag="WARN"; colour='0;33' ;;
    *)    tag="FAIL"; colour='0;31' ;;
  esac
  printf '    ' >&2; _col "$colour"; printf '%-4s' "$tag" >&2; _col '0'
  printf '  %-26s %s\n' "$label" "$detail" >&2
  if [ -n "$remedy" ]; then
    printf '          %-26s fix: %s\n' "" "$remedy" >&2
  fi
  return 0
}

doctor_add() {     # <id> <pass|warn|fail> <label> [detail] [remediation]
  local id="$1" status="$2" label="$3" detail="" remedy=""
  detail="$(_oneline "${4:-}")"
  remedy="$(_oneline "${5:-}")"
  DOC_ID+=("$id"); DOC_STATUS+=("$status"); DOC_LABEL+=("$label")
  DOC_DETAIL+=("$detail"); DOC_REMEDY+=("$remedy")
  case "$status" in
    pass) DOC_PASS=$((DOC_PASS + 1)) ;;
    warn) DOC_WARN=$((DOC_WARN + 1)) ;;
    *)    DOC_FAIL=$((DOC_FAIL + 1)) ;;
  esac
  if [ "$DOC_JSON" != true ]; then doctor_print "$status" "$label" "$detail" "$remedy"; fi
  return 0
}

doctor_emit_json() {
  local i=0 n="${#DOC_ID[@]}" sep=""
  printf '{"checks":['
  while [ "$i" -lt "$n" ]; do
    printf '%s{"id":"%s","label":"%s","status":"%s","detail":"%s","remediation":"%s"}' \
      "$sep" \
      "$(_json_escape "${DOC_ID[$i]}")" \
      "$(_json_escape "${DOC_LABEL[$i]}")" \
      "$(_json_escape "${DOC_STATUS[$i]}")" \
      "$(_json_escape "${DOC_DETAIL[$i]}")" \
      "$(_json_escape "${DOC_REMEDY[$i]}")"
    sep=","
    i=$((i + 1))
  done
  printf '],"summary":{"pass":%d,"warn":%d,"fail":%d}}\n' "$DOC_PASS" "$DOC_WARN" "$DOC_FAIL"
  return 0
}

# Count existing paths among the globs. An unmatched glob stays literal and counts 0, so
# this never needs nullglob (which would change behaviour for the rest of the script).
doctor_count() {
  local n=0 p
  for p in "$@"; do
    if [ -e "$p" ]; then n=$((n + 1)); fi
  done
  printf '%s' "$n"
}

# One-shot scope.yml probe: parse status plus the two fields that decide whether this
# engagement is authorized to run at all. Emits key=value lines and never fails hard.
# "PyYAML is missing" and "the YAML is malformed" are reported as DIFFERENT statuses: they
# have different fixes, and sending an operator to re-indent a perfectly good scope.yml
# because the interpreter has no yaml module is exactly the hand-diagnosis Appendix D.3
# says this verb exists to prevent.
doctor_scope_probe() {
  "$DOC_PY" - "$1" "$REPO_ROOT/vendor/python" <<'PY' 2>/dev/null || true
import sys
sys.path.append(sys.argv[2])          # offline kit: vendored PyYAML fallback (CONTRACTS §1.1)
try:
    import yaml
except Exception as exc:
    print("parse=nodeps")
    print("error=%s" % str(exc).replace("\n", " ")[:200])
    sys.exit(0)
try:
    with open(sys.argv[1], encoding="utf-8") as fh:
        data = yaml.safe_load(fh) or {}
    if not isinstance(data, dict):
        raise ValueError("top level is not a mapping")
except Exception as exc:
    # PyYAML embeds the stream name in the message; on a long kit path that alone would eat
    # the 200-char budget and drop the line/column that actually locates the error.
    print("parse=err")
    print("error=%s" % str(exc).replace(sys.argv[1], "scope.yml").replace("\n", " ")[:200])
    sys.exit(0)
entries = data.get("in_scope") or []
print("parse=ok")
print("client=%s" % (data.get("client") or ""))
print("authorized_by=%s" % (data.get("authorized_by") or ""))
print("in_scope=%d" % (len(entries) if isinstance(entries, list) else -1))
PY
}

doctor_engagement_checks() {
  local dir="$1" id="$2"
  local rel="engagements/$id"

  # --- scope.yml: the authorization rail. Everything else is downstream of it (§15.2).
  if [ ! -f "$dir/scope.yml" ]; then
    doctor_add scope fail "scope.yml" "missing from $rel — this engagement has no authorization rail" \
      "restore it from your authorization document, or recreate the volume: $PROG new-engagement -i $id"
  elif [ -z "$DOC_PY" ]; then
    doctor_add scope warn "scope.yml" "present, but cannot be parsed without python3" \
      "fix the python3 check above, then re-run $PROG doctor"
  else
    local probe="" parse="" perr="" client="" authorized="" in_scope_n=""
    probe="$(doctor_scope_probe "$dir/scope.yml")"
    local key val
    while IFS='=' read -r key val; do
      val="${val%$'\r'}"          # tolerate a CRLF-writing interpreter: this output is parsed
      case "$key" in
        parse)         parse="$val" ;;
        error)         perr="$val" ;;
        client)        client="$val" ;;
        authorized_by) authorized="$val" ;;
        in_scope)      in_scope_n="$val" ;;
      esac
    done <<EOF
$probe
EOF

    if [ "$parse" = "nodeps" ]; then
      doctor_add scope warn "scope.yml" \
        "present, but PyYAML will not import here (${perr:-import failed}) — not validated" \
        "fix the engine deps check above (pip install -r requirements.txt, or restore the offline bundle: bin/vendor-deps python), then re-run $PROG doctor"
    elif [ "$parse" != "ok" ]; then
      doctor_add scope fail "scope.yml" "does not parse: ${perr:-unknown YAML error}" \
        "fix the YAML in $rel/scope.yml (indentation/quoting), then re-run $PROG doctor"
    else
      doctor_add scope pass "scope.yml" "parses; client '${client:-(unset)}'"

      case "$authorized" in
        "")           doctor_add scope_auth fail "scope authorized_by" \
                        "empty — the scope names no authorization, so no run is defensible (design §15.2)" \
                        "set authorized_by in $rel/scope.yml to the name, title and signed SOW reference" ;;
        "CHANGE ME"*) doctor_add scope_auth fail "scope authorized_by" \
                        "still the template placeholder ('CHANGE ME ...')" \
                        "set authorized_by in $rel/scope.yml to the name, title and signed SOW reference" ;;
        *)            doctor_add scope_auth pass "scope authorized_by" "$authorized" ;;
      esac

      if [ "${in_scope_n:-0}" = "-1" ]; then
        doctor_add scope_in fail "scope in_scope" "in_scope is not a list — the scope gate cannot read it" \
          "make in_scope a YAML list of {cidr,groups} / {host,ip,groups} entries in $rel/scope.yml (CONTRACTS §1.4)"
      elif [ "${in_scope_n:-0}" -gt 0 ] 2>/dev/null; then
        doctor_add scope_in pass "scope in_scope" "$in_scope_n entr(y/ies) authorized"
      else
        doctor_add scope_in fail "scope in_scope" \
          "EMPTY — an empty in_scope authorizes nothing (fail-closed), so every collect will be refused" \
          "add cidr/host entries to $rel/scope.yml, then: python3 scripts/scope_gate.py generate --engagement-dir $rel"
      fi
    fi
  fi

  # --- inventory (generated FROM scope; layer 1 of the scope rail)
  local inv="$dir/inventory/hosts.yml" fg="$dir/inventory/fleet_groups.json"
  if [ -f "$inv" ] && [ -f "$fg" ]; then
    local nhosts=""
    if [ -n "$DOC_PY" ]; then
      nhosts="$("$DOC_PY" -c 'import json,sys; print(len(json.load(open(sys.argv[1],encoding="utf-8"))))' "$fg" 2>/dev/null || true)"
      nhosts="${nhosts//[^0-9]/}"   # it is a count or it is nothing
    fi
    # "we could not count" is NOT "the count is zero": reporting an unreadable count as an
    # empty inventory would send the operator off to edit a scope.yml that is already right.
    if [ -z "$nhosts" ]; then
      doctor_add inventory warn "inventory generated" \
        "hosts.yml + fleet_groups.json present, but the host count could not be read here" \
        "fix the python3 check above (or repair $rel/inventory/fleet_groups.json: python3 scripts/scope_gate.py generate --engagement-dir $rel), then re-run $PROG doctor"
    elif [ "$nhosts" = "0" ]; then
      doctor_add inventory warn "inventory generated" \
        "hosts.yml + fleet_groups.json present but hold 0 hosts (CIDR-only scope declares ranges, not machines)" \
        "add host/ip entries to $rel/scope.yml, then: python3 scripts/scope_gate.py generate --engagement-dir $rel"
    else
      doctor_add inventory pass "inventory generated" "$nhosts host(s) in inventory/hosts.yml"
    fi
  elif [ -f "$inv" ] || [ -f "$fg" ]; then
    doctor_add inventory warn "inventory generated" "partially generated — hosts.yml and fleet_groups.json must both exist" \
      "python3 scripts/scope_gate.py generate --engagement-dir $rel"
  else
    doctor_add inventory warn "inventory generated" "not generated yet — nothing is addressable" \
      "python3 scripts/scope_gate.py generate --engagement-dir $rel"
  fi

  # --- vault: creds are injected on arrival and shredded on departure (design §15.3)
  local vf="$dir/vault/vault.yml"
  if [ -f "$vf" ]; then
    if head -n1 "$vf" 2>/dev/null | grep -q 'ANSIBLE_VAULT'; then
      doctor_add vault pass "engagement vault" "vault/vault.yml present and ansible-vault encrypted"
    else
      doctor_add vault fail "engagement vault" \
        "vault/vault.yml is NOT ansible-vault encrypted — plaintext credentials in the engagement volume" \
        "ansible-vault encrypt $rel/vault/vault.yml"
    fi
  else
    doctor_add vault warn "engagement vault" "no vault/vault.yml — handed-over credentials not injected yet (design §15.3)" \
      "ansible-vault create $rel/vault/vault.yml"
  fi

  # --- artifacts: what this engagement has actually produced so far
  local n_snap=0 p
  for p in "$dir"/snapshots/*/*.json; do
    case "$p" in */_run/*) continue ;; esac
    if [ -f "$p" ]; then n_snap=$((n_snap + 1)); fi
  done
  local n_find n_rep last
  n_find="$(doctor_count "$dir"/findings/*.ndjson)"
  n_rep="$(doctor_count "$dir"/reports/*.md)"
  last="$(latest_run_id || true)"
  doctor_add artifacts pass "engagement artifacts" \
    "snapshots:$n_snap findings:$n_find reports:$n_rep last_run:${last:-none}"
  return 0
}

cmd_doctor() {
  local json=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=true; shift ;;
      *) die "doctor: unknown option '$1'   (usage: $PROG [--engagement <id>] doctor [--json])" ;;
    esac
  done
  DOC_JSON="$json"

  if [ "$DOC_JSON" != true ]; then
    info "doctor — kit self-check (design Appendix D.3); every non-PASS line carries its fix"
  fi

  # ======================================================================= kit / tooling
  doctor_section "kit / tooling"

  local bmaj="${BASH_VERSINFO[0]:-0}"
  if [ "$bmaj" -ge 4 ] 2>/dev/null; then
    doctor_add bash pass "bash version" "bash ${BASH_VERSION:-?}"
  elif [ "$bmaj" -eq 3 ] 2>/dev/null; then
    doctor_add bash warn "bash version" "bash ${BASH_VERSION:-?} — the kit is developed and tested against bash 4+" \
      "install a current bash (apt install bash / dnf install bash) and re-run"
  else
    doctor_add bash fail "bash version" "not running under a recognised bash (${BASH_VERSION:-unknown})" \
      "run the console with bash: bash bin/driftwatch doctor"
  fi

  local kernel="" krel=""
  kernel="$(uname -s 2>/dev/null || echo unknown)"
  krel="$(uname -r 2>/dev/null || true)"
  if [ "$kernel" = "Linux" ]; then
    doctor_add platform pass "control node OS" "Linux ${krel:-?}"
  else
    doctor_add platform warn "control node OS" \
      "$kernel ${krel:-} — the roles, collections and krb5 tooling target a Linux control node" \
      "run driftwatch from the Linux kit image (design §15.4); results here are indicative only"
  fi

  # python3 specifically: every script is invoked as `python3 ...`, so a bare `python` is
  # not a substitute.
  local pyver="" pymaj="" pymin=""
  if command -v python3 >/dev/null 2>&1; then
    pyver="$(python3 -c 'import sys; print("%d.%d.%d" % sys.version_info[:3])' 2>/dev/null || true)"
    pyver="${pyver//[^0-9.]/}"     # a dotted version or nothing — never a stray CR
    pymaj="${pyver%%.*}"
    pymin="${pyver#*.}"; pymin="${pymin%%.*}"
    if [ "${pymaj:-0}" -gt 3 ] 2>/dev/null || { [ "${pymaj:-0}" -eq 3 ] 2>/dev/null && [ "${pymin:-0}" -ge 11 ] 2>/dev/null; }; then
      DOC_PY="python3"
      doctor_add python pass "python3 >= 3.11" "python3 $pyver ($(command -v python3))"
    elif [ -n "$pyver" ]; then
      doctor_add python fail "python3 >= 3.11" "python3 $pyver is too old — the engine uses 3.11+ syntax" \
        "install Python 3.11+ (apt install python3.11 / dnf install python3.11) and put it first on PATH"
    else
      doctor_add python fail "python3 >= 3.11" "python3 is on PATH but will not run" \
        "reinstall python3 (apt install --reinstall python3) and re-run $PROG doctor"
    fi
  elif command -v python >/dev/null 2>&1; then
    doctor_add python fail "python3 >= 3.11" "only 'python' is on PATH — the scripts are invoked as 'python3'" \
      "install python3 (apt install python3) or symlink it: ln -s \"\$(command -v python)\" /usr/local/bin/python3"
  else
    doctor_add python fail "python3 >= 3.11" "not found on PATH" \
      "install Python 3.11+ (apt install python3 / dnf install python3.11)"
  fi

  # Engine deps. Installed copies win at runtime (_vendor.py only APPENDS vendor/python to
  # sys.path), so report which source is actually in use — and warn when the offline
  # fallback is missing, because air-gapped deployment is a first-class path.
  local dep_installed=false dep_vendored=false
  if [ -n "$DOC_PY" ]; then
    if ( unset PYTHONPATH; "$DOC_PY" -c 'import yaml, jinja2' ) >/dev/null 2>&1; then
      dep_installed=true
    fi
    # The vendored bundle counts as working only if the tree is actually there AND imports
    # resolve with it on the path — presence alone would pass on an empty directory.
    if [ -f "$REPO_ROOT/vendor/python/yaml/__init__.py" ] \
       && [ -f "$REPO_ROOT/vendor/python/jinja2/__init__.py" ] \
       && ( unset PYTHONPATH; PYTHONPATH="$REPO_ROOT/vendor/python" "$DOC_PY" -c 'import yaml, jinja2' ) >/dev/null 2>&1; then
      dep_vendored=true
    fi
  fi
  if [ -z "$DOC_PY" ]; then
    doctor_add engine_deps fail "engine deps (yaml/jinja2)" "not checked — no usable python3" \
      "fix the python3 check above first"
  elif [ "$dep_installed" = true ] && [ "$dep_vendored" = true ]; then
    doctor_add engine_deps pass "engine deps (yaml/jinja2)" "installed (in use) + vendor/python fallback intact"
  elif [ "$dep_installed" = true ]; then
    doctor_add engine_deps warn "engine deps (yaml/jinja2)" \
      "installed (in use), but vendor/python is missing or broken — the offline/air-gapped path would fail" \
      "rebuild the vendored copies: bin/vendor-deps python"
  elif [ "$dep_vendored" = true ]; then
    doctor_add engine_deps pass "engine deps (yaml/jinja2)" "vendored (vendor/python) — the engine runs on a bare interpreter"
  else
    doctor_add engine_deps fail "engine deps (yaml/jinja2)" "PyYAML/Jinja2 importable neither from site-packages nor from vendor/python" \
      "pip install -r requirements.txt   (air-gapped: bin/bootstrap --offline; to restore the bundle: bin/vendor-deps python)"
  fi

  local ap="" ag=""
  ap="$(command -v ansible-playbook 2>/dev/null || true)"
  ag="$(command -v ansible-galaxy 2>/dev/null || true)"
  if [ -n "$ap" ] && [ -n "$ag" ]; then
    local aver=""
    aver="$(ansible-playbook --version 2>/dev/null | head -n1 || true)"
    doctor_add ansible pass "ansible-playbook/galaxy" "${aver:-present} ($ap)"
  elif [ -x "$REPO_ROOT/.venv/bin/ansible-playbook" ]; then
    doctor_add ansible warn "ansible-playbook/galaxy" "present in .venv but not on PATH" \
      ". $REPO_ROOT/.venv/bin/activate"
  else
    doctor_add ansible fail "ansible-playbook/galaxy" "not found on PATH — no collection can run" \
      "bin/bootstrap   (air-gapped: bin/bootstrap --offline)"
  fi

  # Collections, checked along ansible.cfg's collections_path (./collections first).
  local coll_missing="" c ns nm
  for c in ansible.windows ansible.posix community.general ansible.netcommon; do
    ns="${c%%.*}"; nm="${c#*.}"
    if [ -d "$REPO_ROOT/collections/ansible_collections/$ns/$nm" ] \
       || [ -d "${HOME:-/nonexistent}/.ansible/collections/ansible_collections/$ns/$nm" ] \
       || [ -d "/usr/share/ansible/collections/ansible_collections/$ns/$nm" ]; then
      continue
    fi
    coll_missing="$coll_missing $c"
  done
  if [ -z "$coll_missing" ]; then
    doctor_add collections pass "ansible collections" "core 4 present (ansible.windows, ansible.posix, community.general, ansible.netcommon)"
  else
    doctor_add collections warn "ansible collections" "missing:$coll_missing" \
      "ansible-galaxy collection install -r requirements.yml -p ./collections   (air-gapped: bin/bootstrap --offline)"
  fi

  # The ZIP-download trap: GitHub's "Download ZIP" drops the Unix exec bit (README).
  local noexec="" absent="" f
  for f in driftwatch bootstrap vendor-deps; do
    if [ ! -e "$BIN_DIR/$f" ]; then
      absent="$absent bin/$f"
    elif [ ! -x "$BIN_DIR/$f" ]; then
      noexec="$noexec bin/$f"
    fi
  done
  if [ -n "$noexec" ]; then
    doctor_add exec_bits fail "bin/ exec bits" "not executable:$noexec (a GitHub ZIP download drops the Unix exec bit)" \
      "chmod +x bin/driftwatch bin/bootstrap bin/vendor-deps"
  elif [ -n "$absent" ]; then
    doctor_add exec_bits warn "bin/ exec bits" "missing from this deployment:$absent" \
      "re-deploy the kit from git (or a complete archive) — bin/ must ship whole"
  else
    doctor_add exec_bits pass "bin/ exec bits" "driftwatch, bootstrap, vendor-deps all executable"
  fi

  # ======================================================= windows transport (design §3.1)
  doctor_section "windows transport prereqs (design §3.1 — rung 1: Kerberos over WinRM-HTTPS)"

  local kinit_p="" klist_p=""
  kinit_p="$(command -v kinit 2>/dev/null || true)"
  klist_p="$(command -v klist 2>/dev/null || true)"
  if [ -n "$kinit_p" ] && [ -n "$klist_p" ]; then
    doctor_add krb5_tools pass "krb5 client tools" "kinit + klist present ($kinit_p)"
  else
    doctor_add krb5_tools warn "krb5 client tools" \
      "kinit/klist not both on PATH — Kerberos (rung 1) unavailable; only OpenSSH (rung 2) / NTLM (rung 3) remain" \
      "sudo apt install krb5-user   (RHEL: sudo dnf install krb5-workstation) — bake this into the kit image"
  fi

  local realm=""
  if [ -r /etc/krb5.conf ]; then
    realm="$(awk -F= '/^[[:space:]]*default_realm/ { gsub(/[[:space:]]/, "", $2); print $2; exit }' /etc/krb5.conf 2>/dev/null || true)"
    if [ -z "$realm" ]; then
      realm="$(awk '/^[[:space:]]*\[realms\]/ { f = 1; next } f && /^[[:space:]]*\[/ { f = 0 } f && /=/ { gsub(/[[:space:]]/, "", $1); print $1; exit }' /etc/krb5.conf 2>/dev/null || true)"
    fi
    if [ -n "$realm" ]; then
      doctor_add krb5_conf pass "/etc/krb5.conf realm" "names realm $realm"
    else
      doctor_add krb5_conf warn "/etc/krb5.conf realm" "exists but names no realm — kinit has no KDC to talk to" \
        "add [libdefaults] default_realm = CLIENT.REALM and a [realms] stanza with the client's KDC (design §3.1)"
    fi
  else
    doctor_add krb5_conf warn "/etc/krb5.conf realm" "absent — needed only for the Kerberos rung, but that is the default transport" \
      "create /etc/krb5.conf with the client's realm + KDC, and point the kit's DNS at the client DC (design §3.1)"
  fi

  if [ -n "$klist_p" ]; then
    if klist -s >/dev/null 2>&1; then
      local princ=""
      princ="$(klist 2>/dev/null | awk -F': *' '/[Dd]efault principal/ { print $2; exit }' || true)"
      doctor_add tgt pass "kerberos TGT" "ticket cache holds a TGT${princ:+ for $princ}"
    else
      doctor_add tgt warn "kerberos TGT" "no usable TGT in the ticket cache (klist -s)" \
        "kinit <collector-account>@${realm:-CLIENT.REALM}"
    fi
  else
    doctor_add tgt warn "kerberos TGT" "klist not installed — cannot verify the ticket cache" \
      "sudo apt install krb5-user, then: kinit <collector-account>@${realm:-CLIENT.REALM}"
  fi

  # Clock: Kerberos rejects tickets beyond ~5 minutes of skew, and skew + DNS account for
  # most "Kerberos doesn't work" incidents (design §3.1).
  local clock_src="" skew="" leap="" tracking=""
  if command -v chronyc >/dev/null 2>&1; then
    clock_src="chronyc"
    tracking="$(chronyc tracking 2>/dev/null || true)"
    if [ -n "$tracking" ]; then
      skew="$(printf '%s\n' "$tracking" | awk -F: '/^System time/ { print $2; exit }' | awk '{ print $1 }' || true)"
      leap="$(printf '%s\n' "$tracking" | awk -F: '/^Leap status/ { gsub(/^[ \t]+|[ \t]+$/, "", $2); print $2; exit }' || true)"
    fi
  elif command -v timedatectl >/dev/null 2>&1; then
    clock_src="timedatectl"
    leap="$(timedatectl show -p NTPSynchronized --value 2>/dev/null || true)"
    if [ -z "$leap" ]; then
      leap="$(timedatectl status 2>/dev/null | awk -F': *' '/[Ss]ynchronized/ { print $2; exit }' || true)"
    fi
  fi
  local clock_fix="point chrony at the client's DC/NTP, then step the clock: sudo chronyc makestep && chronyc tracking"
  if [ -z "$clock_src" ]; then
    doctor_add clock warn "clock sync (<5 min)" "neither chronyc nor timedatectl on this host — skew is not verifiable here" \
      "install chrony and sync against the client DC/NTP, or compare the kit clock to the DC by hand before collecting"
  elif [ -n "$skew" ] && printf '%s' "$skew" | grep -Eq '^-?[0-9]+([.][0-9]+)?$'; then
    if awk -v s="$skew" 'BEGIN { if (s < 0) s = -s; exit (s >= 300) ? 0 : 1 }'; then
      doctor_add clock fail "clock sync (<5 min)" "system time is ${skew}s off NTP — past Kerberos' 5-minute tolerance, every ticket will be rejected" \
        "$clock_fix"
    elif awk -v s="$skew" 'BEGIN { if (s < 0) s = -s; exit (s >= 60) ? 0 : 1 }'; then
      doctor_add clock warn "clock sync (<5 min)" "system time is ${skew}s off NTP — drifting toward the 5-minute Kerberos limit" \
        "$clock_fix"
    elif [ -n "$leap" ] && [ "$leap" != "Normal" ]; then
      doctor_add clock warn "clock sync (<5 min)" "offset ${skew}s, but chrony leap status is '$leap' (not synchronised)" \
        "$clock_fix"
    else
      doctor_add clock pass "clock sync (<5 min)" "offset ${skew}s off NTP, chrony leap status ${leap:-unknown}"
    fi
  elif [ "$clock_src" = "timedatectl" ]; then
    case "$leap" in
      yes|true|synchronized|Synchronized)
        doctor_add clock pass "clock sync (<5 min)" "NTP-synchronised (timedatectl); offset not reported by this tool" ;;
      *)
        doctor_add clock warn "clock sync (<5 min)" "clock is NOT NTP-synchronised (timedatectl NTPSynchronized=${leap:-unknown})" \
          "sudo timedatectl set-ntp true, or run chrony against the client DC/NTP (design §3.1)" ;;
    esac
  else
    doctor_add clock warn "clock sync (<5 min)" "chronyc is installed but chronyd is not answering (no tracking data)" \
      "sudo systemctl start chronyd   (Debian/Ubuntu: chrony), then: chronyc tracking"
  fi

  # ========================================================================== engagement
  doctor_section "engagement"

  # doctor is the one verb that must work with NO engagement selected — it is what you run
  # on a fresh kit, before there is anything to select.
  local eng=""
  eng="${ENGAGEMENT:-}"
  [ -n "$eng" ] || eng="${DRIFTWATCH_ENGAGEMENT:-}"
  if [ -z "$eng" ]; then
    doctor_add engagement warn "engagement selected" "none — engagement checks skipped (kit checks above are complete)" \
      "$PROG --engagement <id> doctor, or: export DRIFTWATCH_ENGAGEMENT=<id>"
  elif [ -d "$REPO_ROOT/engagements/$eng" ]; then
    ENGAGEMENT="$eng"
    ENGAGEMENT_DIR="$REPO_ROOT/engagements/$eng"
    doctor_add engagement pass "engagement volume" "$eng at engagements/$eng"
    doctor_engagement_checks "$ENGAGEMENT_DIR" "$eng"
  else
    doctor_add engagement fail "engagement volume" "'$eng' is selected but engagements/$eng does not exist" \
      "$PROG new-engagement -i $eng"
  fi

  # audit.log is the operator's record of everything the tool did in this engagement.
  if [ -n "$ENGAGEMENT_DIR" ] && [ -d "$ENGAGEMENT_DIR" ]; then
    audit "doctor" "-" "pass=$DOC_PASS warn=$DOC_WARN fail=$DOC_FAIL" || true
  fi

  if [ "$DOC_JSON" = true ]; then
    doctor_emit_json
  else
    printf '\n' >&2
    if [ "$DOC_FAIL" -gt 0 ]; then
      err "doctor: $DOC_PASS pass, $DOC_WARN warn, $DOC_FAIL FAIL — not ready; each FAIL above names the command that fixes it"
    else
      info "doctor: $DOC_PASS pass, $DOC_WARN warn, 0 fail — kit ready (warnings are advisory, not blocking)"
    fi
  fi

  [ "$DOC_FAIL" -eq 0 ] || return 1
  return 0
}

# Secure-delete a path. On modern SSD/CoW/network filesystems shred cannot guarantee the
# blocks are gone — the LOAD-BEARING control is that the engagement volume is encrypted at
# rest (design §15.1); shred is defense-in-depth on top of that. Intent documented on purpose.
secure_delete() {
  local target="$1"
  [ -e "$target" ] || return 0
  if command -v shred >/dev/null 2>&1; then
    find "$target" -type f -exec shred -u -z -n 3 {} + 2>/dev/null || true
  elif command -v srm >/dev/null 2>&1; then
    find "$target" -type f -exec srm -f {} + 2>/dev/null || true
  else
    warn "no shred/srm on the kit — falling back to rm; rely on the encrypted volume for erasure"
  fi
  rm -rf "$target"
}

teardown_class_dir() {
  case "$1" in
    report)     echo "reports" ;;
    findings)   echo "findings" ;;
    cases)      echo "cases" ;;
    snapshots)  echo "snapshots" ;;
    configs)    echo "configs" ;;
    baselines)  echo "baselines" ;;
    evidence)   echo "evidence" ;;
    inventory)  echo "inventory" ;;
    preflight)  echo "preflight" ;;
    *)          echo "" ;;
  esac
}

cmd_teardown() {
  local retain="report" assume_yes=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --retain)     retain="${2:-}"; shift 2 ;;
      --retain=*)   retain="${1#*=}"; shift ;;
      --yes|--force) assume_yes=true; shift ;;
      *) die "teardown: unknown option '$1'" ;;
    esac
  done
  resolve_engagement

  # Default profile: shred everything except the report (fail-safe toward LESS retained
  # client data, design §15.4). The vault is ALWAYS shredded — no retention profile can
  # keep it. audit.log and scope.yml are always KEPT: they are the operator's legal record
  # that the engagement stayed within authorization (§15.2).
  local classes="report findings cases snapshots configs baselines evidence inventory preflight"
  local retain_norm=",${retain//[[:space:]]/},"
  local siem_retained=false
  case "$retain_norm" in *,siem,*) siem_retained=true ;; esac

  local keep=() drop=()
  local cls
  for cls in $classes; do
    case "$retain_norm" in
      *,"$cls",*) keep+=("$cls") ;;
      *)          drop+=("$cls") ;;
    esac
  done

  warn "TEARDOWN engagement '$ENGAGEMENT'"
  warn "  KEEP  : ${keep[*]:-(none)}  + audit.log + scope.yml"
  warn "  SHRED : ${drop[*]:-(none)}  + vault (always) + git history + caches"
  if [ "$siem_retained" != true ]; then
    warn "  SIEM  : Splunk/Security Onion indices are NOT wiped by this tool — wipe them"
    warn "          deliberately (design §15.4); pass --retain ...,siem to acknowledge keeping them."
  fi
  warn "  Export anything you are retaining to your designated store BEFORE this runs."

  if [ "$assume_yes" != true ]; then
    printf '[%s] type the engagement id (%s) to confirm teardown: ' "$PROG" "$ENGAGEMENT" >&2
    local answer=""
    read -r answer || true
    [ "$answer" = "$ENGAGEMENT" ] || die "confirmation did not match — teardown aborted (nothing shredded)"
  fi

  # vault ALWAYS — no override.
  secure_delete "$ENGAGEMENT_DIR/vault"
  # Tamper-evidence git repo + runtime caches (may hold copies of shredded classes).
  secure_delete "$ENGAGEMENT_DIR/.git"
  secure_delete "$ENGAGEMENT_DIR/.factcache"
  secure_delete "$ENGAGEMENT_DIR/.retry"
  rm -f "$ENGAGEMENT_DIR/.collect.lock" 2>/dev/null || true

  for cls in "${drop[@]}"; do
    local d; d="$(teardown_class_dir "$cls")"
    [ -n "$d" ] && secure_delete "$ENGAGEMENT_DIR/$d"
  done
  # Ansible run logs are engagement data too (they record what ran on each host).
  case "$retain_norm" in *,snapshots,*) : ;; *) secure_delete "$ENGAGEMENT_DIR/audit/hostlogs"; secure_delete "$ENGAGEMENT_DIR/audit/ansible-run.log" ;; esac

  audit "teardown" "-" "shredded=[${drop[*]:-}] kept=[${keep[*]:-}] vault=shredded siem_kept=$siem_retained"
  info "teardown complete — kept: ${keep[*]:-(report only)} (+ audit.log, scope.yml). Rebuild the kit from image before the next engagement."
}

# --------------------------------------------------------------------------- usage / dispatch
usage() {
  cat >&2 <<EOF
$PROG — blue-team baseline & drift-detection operator console

usage: $PROG [--engagement <id>] <verb> [options]
  (engagement resolves from --engagement or \$DRIFTWATCH_ENGAGEMENT; required for all
   verbs except new-engagement, which takes the id as an argument, and doctor, which
   checks the kit itself and only adds the engagement checks when one is selected)

verbs:
  doctor [--json]                     self-check the kit: deps, Kerberos prereqs and
                                      engagement readiness; exit 1 on any FAIL
  new-engagement [-i] <id>            create an engagement volume from the template
                                      (-i/--interactive: guided, validated scope.yml)
  preflight                           Kerberos prereqs + Windows transport matrix
  collect [--deep] [--limit PATTERN] [--collect-only]
                                      scope-gate -> snapshot -> (diff -> report)
  diff [--run-id R]                   normalize + diff engine on the control node
  report [--run-id R]                 render Markdown + HTML report
  ship [--run-id R]                   ship findings to the kit SIEM (per scope.yml settings)
  baseline promote <host> <run_id> [--ticket T]
  respond <propose|approve|rollback> ...   passthrough to the response layer
  gui [--port N] [--no-browser]       operator GUI, bound to 127.0.0.1 only (dashboard,
                                      findings browser, fleet matrix, setup wizard; no
                                      response/approve, teardown, or credential surface)
  status                              read-only engagement dashboard
  teardown [--retain a,b,...] [--yes] shred the volume (report kept by default; vault ALWAYS)

examples:
  $PROG doctor                        # first thing on a fresh kit
  $PROG new-engagement acme-2026-07
  $PROG new-engagement -i acme-2026-07
  DRIFTWATCH_ENGAGEMENT=acme-2026-07 $PROG doctor --json | jq .summary
  DRIFTWATCH_ENGAGEMENT=acme-2026-07 $PROG preflight
  $PROG --engagement acme-2026-07 collect --deep
  $PROG --engagement acme-2026-07 teardown --retain report,findings
EOF
}

main() {
  # Pull the global --engagement out of the arg stream wherever it appears.
  local rest=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --engagement)   ENGAGEMENT="${2:-}"; [ -n "$ENGAGEMENT" ] || die "--engagement needs a value"; shift 2 ;;
      --engagement=*) ENGAGEMENT="${1#*=}"; shift ;;
      *)              rest+=("$1"); shift ;;
    esac
  done
  set -- ${rest[@]+"${rest[@]}"}

  local verb="${1:-}"
  [ $# -gt 0 ] && shift || true

  case "$verb" in
    doctor)         cmd_doctor "$@" ;;
    new-engagement) cmd_new_engagement "$@" ;;
    preflight)      cmd_preflight "$@" ;;
    collect)        cmd_collect "$@" ;;
    diff)           cmd_diff "$@" ;;
    report)         cmd_report "$@" ;;
    ship)           cmd_ship "$@" ;;
    baseline)       cmd_baseline "$@" ;;
    respond)        cmd_respond "$@" ;;
    gui)            cmd_gui "$@" ;;
    status)         cmd_status "$@" ;;
    teardown)       cmd_teardown "$@" ;;
    ""|-h|--help|help) usage ;;
    *) err "unknown verb: $verb"; usage; exit 1 ;;
  esac
}

main "$@"

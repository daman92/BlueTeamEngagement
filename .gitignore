# --- Secrets & client data: NEVER commit -------------------------------------
# Engagement volumes hold client snapshots, credentials, findings, evidence.
# The template is tracked; real engagements are not.
engagements/*
!engagements/_template/
!engagements/_template/**
**/vault/
**/vault.yml
*.vault
vault_pass*
*.pem
*.key
id_rsa*
krb5.conf

# --- Response layer live cases/evidence --------------------------------------
response/cases/*
!response/cases/.gitkeep
response/evidence/

# --- Python ------------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
*.egg-info/

# --- Ansible runtime ---------------------------------------------------------
*.retry
collections/
ansible_collections/
.ansible/

# --- Vendored dependencies ---------------------------------------------------
# vendor/python/ IS committed (small pure-Python engine deps: PyYAML/Jinja2/MarkupSafe)
# so the tooling runs offline. The heavy offline bundle for the KIT IMAGE
# (collection tarballs + pip wheels, 100s of MB, built by bin/vendor-deps) is NOT.
vendor/wheels/
vendor/collections/
vendor/ansible/

# --- Local run artifacts -----------------------------------------------------
# Anchored to the repo root so these runtime dirs are ignored ONLY where tooling
# actually writes them, NOT inside tests/fixtures/ (whose committed fixtures
# legitimately mirror these names). A leading "/" anchors to this .gitignore's dir.
/reports/*.html
/reports/*.md
!/reports/.gitkeep
/snapshots/
*.log
!docs/**

# Committed test fixtures are always tracked, even when they mirror ignored
# runtime dir names (e.g. tests/fixtures/report/engagement/snapshots/_run/).
!tests/fixtures/**

# --- OS / editor -------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
